<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: neither cloud backup nor device-to-device transfer carries Local History. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="no_backup" path="local_history/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="no_backup" path="local_history/" />
    </device-transfer>
</data-extraction-rules>
